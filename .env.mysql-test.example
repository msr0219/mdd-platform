# Copy this template to .env.mysql-test and fill in a dedicated MySQL test database.
# Do not put credentials inside the URL. Do not point this at production/business data.
MYSQL_TEST_URL=jdbc:mysql://127.0.0.1:3306/mdd_acceptance_test?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_TEST_USERNAME=your_test_user
MYSQL_TEST_PASSWORD=replace_locally
